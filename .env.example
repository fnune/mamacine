# Copy to .env and fill in. .env is gitignored; direnv loads it.

# NZBGeek: profile page -> API key
NZBGEEK_API_KEY=
# NZBGEEK_URL=https://api.nzbgeek.info

# Eweka (or any NNTP provider)
NEWS_HOST=news.eweka.nl
NEWS_PORT=563
NEWS_USER=
NEWS_PASSWORD=
NEWS_SSL=yes
# Match your plan's connection limit
NEWS_CONNECTIONS=8
# 0 = unlimited; Eweka is ~4700 days
NEWS_RETENTION=0

# Where finished, unpacked downloads land
NZBGRAB_DEST=~/Downloads/usenet
NZBGRAB_PORT=8722

# OpenSubtitles (opensubtitles.com -> profile -> API consumer)
OPENSUBTITLES_API_KEY=
# Must match the consumer name registered at opensubtitles.com, or /subtitles returns 403
OPENSUBTITLES_USER_AGENT="mamacine v1.0"
# Downloads need the account itself, not just the key. Free accounts get a daily allowance.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Spanish subtitles are fetched when the film has none she can read
SUBTITLE_LANGUAGE=es
